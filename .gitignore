# Public delivery: explicit entry points. New scope requires review.
*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/.github/
!/.github/workflows/
!/.github/workflows/pages.yml
!/index.html
!/en/
!/en/**/
!/en/**/*.html
!/about/
!/about/*.html
!/exhibitions/
!/exhibitions/**/
!/exhibitions/**/*.html
!/assets/
!/assets/**/
!/assets/**/*.css
!/assets/**/*.js
!/assets/**/*.svg
!/assets/**/*.woff2
!/assets/fonts/*.txt
!/data/
!/data/*.json
!/scripts/
!/scripts/*.mjs
!/docs/
!/docs/SUBMISSION.md
!/docs/REGISTRY.md
!/docs/CONTENT_FORMAT.md
!/docs/RIGHTS.md
!/docs/REPEATABILITY.md
!/docs/research/
!/docs/research/*/
!/docs/research/*/README.md
# Explicit defense even if a broader rule is added above.
internal/
prototypes/
docs/qa/
docs/phase3.1/
docs/SUBMISSION_SPRINT_LOG.md
docs/PHASE3_HANDOFF.md
_site/
.env
.env.*
*.pem
*.key
